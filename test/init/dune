; The cost of loading console. At startup, a program that links console pays
; for every value that a console module builds when it loads, even if it draws
; nothing. Every module of every library is linked, so every initialiser runs.
; init_first comes first, so it samples them all.

(test
 (name test)
 (package console-eio)
 (deps
  (glob_files_rec %{project_root}/lib/**.ml))
 (link_flags (-linkall))
 (libraries
  init_first
  console
  console.text
  console_width
  console.input
  console.tty
  console-eio
  alcotest
  fmt))
