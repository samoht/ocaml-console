(copy_files ../../lib/eio/terminal.{ml,mli})

; Terminal is private to console-eio: its copy is built as console-eio builds
; it, with the modules of console in scope.

(library
 (name terminal)
 (wrapped false)
 (modules terminal)
 (flags
  (:standard -open Console__))
 (libraries console eio eio.unix unix))

(executable
 (name teardown)
 (modules teardown)
 (libraries
  console
  console.tty
  console-eio
  eio
  eio.mock
  eio_main
  fmt
  logs
  unix))

(library
 (name pty_reader)
 (modules pty_reader)
 (libraries cstruct eio eio.unix unix))

(executable
 (name tty)
 (modules tty)
 (libraries
  pty_reader
  console
  console_vte
  cstruct
  eio
  eio.unix
  eio_main
  jsont.bytesrw
  matrix.vte
  unix))

(executable
 (name piped)
 (modules piped)
 (libraries
  console
  console-eio
  eio
  eio.mock
  eio_main
  fmt
  logs
  logs.fmt
  threads.posix
  unix))

(executable
 (name events)
 (modules events)
 (libraries console fmt jsont jsont.bytesrw))

(cram
 (package console-eio)
 (deps
  tty.exe
  piped.exe
  events.exe
  ../../examples/progress/main.exe
  ../../examples/columns/main.exe
  ../../examples/charts/main.exe))

(cram
 (applies_to cast deterministic exit progress size)
 (enabled_if
  (= %{profile} dev)))

(test
 (name test)
 (modules :standard \ teardown tty piped events pty_reader terminal)
 (package console-eio)
 (deps teardown.exe)
 (libraries
  console
  console.tty
  console-eio
  pty_reader
  terminal
  display_harness
  eio_harness
  env_harness
  console_vte
  cstruct
  eio
  eio.unix
  eio.mock
  mtime
  eio_main
  matrix.ansi
  matrix.grid
  matrix.vte
  alcotest
  jsont
  jsont.bytesrw
  astring
  fmt
  logs
  unix))

(rule
 (alias report-domains)
 (action
  (run ./test.exe test report_domains)))
