; Exercise the private geometry, as the Width tests do.

(copy_files ../../lib/eio/terminal.{ml,mli})

(executable
 (name teardown)
 (modules teardown)
 (libraries console console.tty console-eio eio eio_main fmt logs unix))

; Runs a program on a terminal and prints the screen it leaves, for the
; cram tests.

(executable
 (name tty)
 (modules tty)
 (libraries console_vte cstruct eio eio.unix eio_main matrix.vte unix))

(cram
 (package console-eio)
 (deps tty.exe ../../examples/progress/main.exe))

(test
 (name test)
 (modules :standard \ teardown tty)
 (package console-eio)
 (deps teardown.exe)
 (libraries
  console
  console.tty
  console-eio
  display_harness
  console_vte
  cstruct
  eio
  eio.unix
  eio.mock
  mtime
  eio_main
  matrix.grid
  matrix.vte
  alcotest
  astring
  fmt
  logs
  unix))

(rule
 (alias report-domains)
 (action
  (run ./test.exe test report_domains)))
