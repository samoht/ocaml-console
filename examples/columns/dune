(executable
 (name main)
 (libraries console console.tty console-eio eio eio_main fmt))

; columns.t is the run that dune checks and that columns.svg shows. To
; record it again, from the root of the repository:
;
;   dune build examples/columns/main.exe
;   k7 cram --cols 100 --setup examples/columns/setup.sh \
;     --output examples/columns/columns.svg examples/columns/columns.t

(cram
 (package console-eio)
 (deps main.exe)
 (setup_scripts setup.sh))
