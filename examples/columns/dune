(executable
 (name main)
 (libraries console console.tty console-eio eio eio_main fmt))

(rule
 (enabled_if %{bin-available:k7})
 (target columns.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    16
    (run ./main.exe)))))

(rule
 (enabled_if %{bin-available:k7})
 (target columns.generated.svg)
 (action
  (run
   %{bin:k7}
   cast
   --show
   "dune exec -- examples/columns/main.exe"
   -o
   %{target}
   %{dep:columns.cast})))

(rule
 (alias runtest)
 (enabled_if %{bin-available:k7})
 (action
  (diff columns.svg columns.generated.svg)))
