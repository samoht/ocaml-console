Output "examples/columns/columns.gif"
Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 520
Set Theme "Builtin Dark"
Set Padding 20
Set TypingSpeed 20ms
# Generated by tape.ml: two builds side by side.
Require "dune"
Hide
Type "dune build examples/columns/main.exe && alias columns=$PWD/_build/default/examples/columns/main.exe && clear"
Enter
Wait@300000ms
Show
Type "columns"
Enter
Wait@60000ms
Sleep 2000ms
