(executable
 (name main)
 (modules main)
 (libraries console console-eio eio eio_main))

(executable
 (name tape)
 (modules tape)
 (libraries vhs fmt))

(rule
 (target matrix.generated.tape)
 (action
  (with-stdout-to
   %{target}
   (run ./tape.exe))))

(rule
 (alias runtest)
 (action
  (diff matrix.tape matrix.generated.tape)))
