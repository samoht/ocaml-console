Output "examples/quickstart/quickstart.gif"
Set Shell "bash"
Set FontSize 16
Set Width 900
Set Height 560
Set Theme "Builtin Dark"
Set Padding 20
Set TypingSpeed 20ms
# Generated by tape.ml: the README's first program.
Require "dune"
Hide
Type "dune build examples/quickstart/main.exe && alias check=$PWD/_build/default/examples/quickstart/main.exe && clear"
Enter
Wait@300000ms
Show
Type "check"
Enter
Wait@60000ms
Sleep 1500ms
Type "check --theme=rainbow"
Enter
Wait@60000ms
Sleep 1500ms
