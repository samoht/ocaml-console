(rule
 (enabled_if %{lib-available:console-eio})
 (target quickstart.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    25
    (run ./eio/main.exe)))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target rainbow.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    25
    (run ./eio/main.exe --theme=rainbow)))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target quickstart.generated.svg)
 (action
  (run
   %{bin:k7}
   play
   --show
   "dune exec -- examples/quickstart/eio/main.exe"
   --show
   "dune exec -- examples/quickstart/eio/main.exe --theme=rainbow"
   -o
   %{target}
   %{dep:quickstart.cast}
   %{dep:rainbow.cast})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:console-eio})
 (action
  (diff quickstart.svg quickstart.generated.svg)))
