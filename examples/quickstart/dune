(executable
 (name main)
 (libraries
  console
  console.tty
  console-eio
  eio
  eio_main
  fmt
  fmt.cli
  cmdliner))

(rule
 (enabled_if %{bin-available:k7})
 (target quickstart.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    14
    (run ./main.exe)))))

(rule
 (enabled_if %{bin-available:k7})
 (target quickstart.generated.svg)
 (action
  (run
   %{bin:k7}
   cast
   --show
   "dune exec -- examples/quickstart/main.exe"
   -o
   %{target}
   %{dep:quickstart.cast})))

(rule
 (alias runtest)
 (enabled_if %{bin-available:k7})
 (action
  (diff quickstart.svg quickstart.generated.svg)))
