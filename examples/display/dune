(executable
 (name main)
 (modules main)
 (libraries console console.tty console-eio eio eio_main fmt logs))

(executable
 (name tape)
 (modules tape)
 (optional)
 (libraries console vhs fmt))

(rule
 (enabled_if %{lib-available:vhs})
 (target display.generated.tape)
 (action
  (with-stdout-to
   %{target}
   (run ./tape.exe))))

(rule
 (alias runtest)
 (enabled_if %{lib-available:vhs})
 (action
  (diff display.tape display.generated.tape)))

