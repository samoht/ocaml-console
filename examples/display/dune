(executable
 (name main)
 (libraries console console.tty console-eio eio eio_main fmt logs))

(rule
 (enabled_if %{bin-available:k7})
 (target display.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    21
    (run ./main.exe)))))

(rule
 (enabled_if %{bin-available:k7})
 (target display.generated.svg)
 (action
  (run
   %{bin:k7}
   cast
   --show
   "dune exec -- examples/display/main.exe"
   -o
   %{target}
   %{dep:display.cast})))

(rule
 (alias runtest)
 (enabled_if %{bin-available:k7})
 (action
  (diff display.svg display.generated.svg)))

(rule
 (enabled_if %{bin-available:k7})
