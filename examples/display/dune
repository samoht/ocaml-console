 (target matrix.generated.svg)
 (action
  (run
   %{bin:k7}
   cast
   --show
   "dune exec -- examples/display/main.exe matrix"
   --theme
   "{\"name\": \"demo\", \"background\": \"#000000\", \"foreground\": \"#dddddd\", \"cursor\": \"#dddddd\", \"selection\": \"#dddddd\"}"
   -o
   %{target}
   %{dep:matrix.cast})))

(rule
 (alias runtest)
 (enabled_if %{bin-available:k7})
 (action
  (diff matrix.svg matrix.generated.svg)))

