(executable
 (name main)
 (modules main)
 (libraries console console-eio eio eio_main fmt))

(executable
 (name tape)
 (modules tape)
 (optional)
 (libraries vhs fmt))

(rule
 (enabled_if %{lib-available:vhs})
 (target layout.generated.tape)
 (action
  (with-stdout-to
   %{target}
   (run ./tape.exe))))

(rule
 (alias runtest)
 (enabled_if %{lib-available:vhs})
 (action
  (diff layout.tape layout.generated.tape)))
