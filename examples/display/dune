(executable
 (name main)
 (modules main)
 (libraries console console-eio eio eio_main fmt))

(executable
 (name tape)
 (modules tape)
 (optional)
 (libraries vhs fmt))

(rule
 (enabled_if %{lib-available:vhs})
 (target display.generated.tape)
 (action
  (with-stdout-to
   %{target}
   (run ./tape.exe))))

(rule
 (alias runtest)
 (enabled_if %{lib-available:vhs})
 (action
  (diff display.tape display.generated.tape)))

(rule
 (enabled_if %{lib-available:vhs})
 (target matrix.generated.tape)
 (action
  (with-stdout-to
   %{target}
   (run ./tape.exe matrix))))

(rule
 (alias runtest)
 (enabled_if %{lib-available:vhs})
 (action
  (diff matrix.tape matrix.generated.tape)))
