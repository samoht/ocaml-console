Output "_build/themes/catppuccin-latte.txt"
Set Shell "bash"
Set FontSize 16
Set Width 900
Set Height 520
Set Padding 20
Set TypingSpeed 5ms
Set Theme '{ "name": "demo", "background": "#eff1f5", "foreground": "#333333", "cursor": "#333333", "selection": "#333333" }'
# Generated by tape.ml: the theme demo in catppuccin-latte.
Require "dune"
Hide
Type "dune build examples/themes/main.exe && clear"
Enter
Wait@300000ms
Show
Type "dune exec examples/themes/main.exe catppuccin-latte"
Enter
Wait+Screen@60000ms /unused variable/
Sleep 300ms
Screenshot "examples/themes/catppuccin-latte.png"
Wait@60000ms
