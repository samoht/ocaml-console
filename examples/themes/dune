(executable
 (name main)
 (modules main)
 (libraries console console.tty console-eio eio eio_main fmt))

(executable
 (name tape)
 (modules tape)
 (optional)
 (libraries console k7 fmt))

(rule
 (enabled_if %{lib-available:k7})
 (target default.generated.tape)
 (action
  (with-stdout-to
   %{target}
   (run ./tape.exe default))))

(rule
 (alias runtest)
 (enabled_if %{lib-available:k7})
 (action
  (diff default.tape default.generated.tape)))

