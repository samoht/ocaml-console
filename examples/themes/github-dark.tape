Output "_build/themes/github-dark.txt"
Set Shell "bash"
Set FontSize 16
Set Width 900
Set Height 520
Set Padding 20
Set TypingSpeed 5ms
Set Theme '{ "name": "demo", "background": "#0d1117", "foreground": "#dddddd", "cursor": "#dddddd", "selection": "#dddddd" }'
# Generated by tape.ml: the theme demo in github-dark.
Require "dune"
Hide
Type "dune build examples/themes/main.exe && clear"
Enter
Wait@300000ms
Show
Type "dune exec examples/themes/main.exe github-dark"
Enter
Wait+Screen@60000ms /unused variable/
Sleep 300ms
Screenshot "examples/themes/github-dark.png"
Wait@60000ms
