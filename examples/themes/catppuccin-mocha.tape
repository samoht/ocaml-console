Output "_build/themes/catppuccin-mocha.txt"
Set Shell "bash"
Set FontSize 16
Set Width 900
Set Height 520
Set Padding 20
Set TypingSpeed 5ms
Set Theme '{ "name": "demo", "background": "#1e1e2e", "foreground": "#dddddd", "cursor": "#dddddd", "selection": "#dddddd" }'
# Generated by tape.ml: the theme demo in catppuccin-mocha.
Require "dune"
Hide
Type "dune build examples/themes/main.exe && clear"
Enter
Wait@300000ms
Show
Type "dune exec examples/themes/main.exe catppuccin-mocha"
Enter
Wait+Screen@60000ms /unused variable/
Sleep 300ms
Screenshot "examples/themes/catppuccin-mocha.png"
Wait@60000ms
