Output "_build/themes/github-light.txt"
Set Shell "bash"
Set FontSize 16
Set Width 900
Set Height 520
Set Padding 20
Set TypingSpeed 5ms
Set Theme '{ "name": "demo", "background": "#ffffff", "foreground": "#333333", "cursor": "#333333", "selection": "#333333" }'
# Generated by tape.ml: the theme demo in github-light.
Require "dune"
Hide
Type "dune build examples/themes/main.exe && clear"
Enter
Wait@300000ms
Show
Type "dune exec examples/themes/main.exe github-light"
Enter
Wait+Screen@60000ms /unused variable/
Sleep 300ms
Screenshot "examples/themes/github-light.png"
Wait@60000ms
