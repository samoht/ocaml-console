; Width is private to the library; the properties compile it in.

(copy_files ../lib/width.{ml,mli})

(executable
 (name fuzz)
 (libraries
  console
  console.text
  console-eio
  eio
  eio.unix
  eio_main
  logs
  cstruct
  unix
  matrix.glyph
  matrix.grid
  matrix.vte
  fmt
  re
  alcobar))

; The property run is a quick smoke; deep exploration is the fuzz alias.

(rule
 (alias runtest)
 (package console)
 (enabled_if
  (<> %{profile} afl))
 (deps fuzz.exe ../test/eio/teardown.exe)
 (action
  (run %{exe:fuzz.exe} --budget 0.3)))

(rule
 (alias fuzz)
 (package console)
 (enabled_if
  (= %{profile} afl))
 (deps fuzz.exe ../test/eio/teardown.exe)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run afl-fuzz -V 60 -i corpus -o _fuzz -- %{exe:fuzz.exe} @@))))
