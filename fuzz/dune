; Width and Display_json are private to the library; the properties compile
; them in.

(copy_files ../lib/input/width.{ml,mli})

(copy_files ../lib/display_json.{ml,mli})

(executable
 (name fuzz)
 (modules :standard \ fuzz_eio fuzz_console_eio)
 (libraries
  console
  console.input
  console.text
  matrix.ansi
  matrix.glyph
  matrix.grid
  console_vte
  display_harness
  matrix.vte
  fmt
  re
  yojson
  alcobar))

; The property run is a quick smoke; deep exploration is the fuzz alias.

(rule
 (alias runtest)
 (package console)
 (enabled_if
  (<> %{profile} afl))
 (deps fuzz.exe)
 (action
  (run %{exe:fuzz.exe} --budget 0.3)))

(rule
 (alias fuzz)
 (package console)
 (enabled_if
  (= %{profile} afl))
 (deps fuzz.exe)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run afl-fuzz -V 60 -i corpus -o _fuzz -- %{exe:fuzz.exe} @@))))

; Eio properties have their own runner so the pure package needs no Eio.

(executable
 (name fuzz_eio)
 (modules fuzz_eio fuzz_console_eio)
 (libraries
  console
  console-eio
  console_vte
  console.text
  eio
  eio.mock
  unix
  logs
  fmt
  yojson
  alcobar))

(rule
 (alias runtest)
 (package console-eio)
 (deps ../test/eio/tty.exe ../test/eio/teardown.exe)
 (enabled_if
  (<> %{profile} afl))
 (action
  (run %{exe:fuzz_eio.exe} --budget 0.3)))

(rule
 (alias fuzz)
 (package console-eio)
 (deps ../test/eio/tty.exe ../test/eio/teardown.exe)
 (enabled_if
  (= %{profile} afl))
 (action
  (progn
   (run %{exe:fuzz_eio.exe} --gen-corpus corpus-eio)
   (run afl-fuzz -V 60 -i corpus-eio -o _fuzz_eio -- %{exe:fuzz_eio.exe} @@))))
