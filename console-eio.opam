# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio backend for console"
description: """
Runs a Console.Display on the terminal with Eio: finds whether the
   output is a terminal and its size, redraws the progress rows, prints
   Logs messages above them and gives the terminal back on exit. Also
   asks questions on the terminal, passwords included."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["command-line-utilities" "format" "eio"]
homepage: "https://github.com/samoht/ocaml-console"
bug-reports: "https://github.com/samoht/ocaml-console/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.4"}
  "console"
  "eio" {>= "1.4"}
  "fmt"
  "logs"
  "alcotest" {with-test & >= "1.7.0"}
  "astring" {with-test}
  "mdx" {with-test}
  "cstruct" {with-test}
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-console.git"
x-maintenance-intent: ["(latest)"]
