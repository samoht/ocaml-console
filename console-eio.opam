opam-version: "2.0"
synopsis: "Eio backend for console"
description: """
Helpers that animate Console.Display bars from an Eio fiber. Split out
   so the core tty library stays scheduler-agnostic."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: [
  "org:blacksun" "command-line-utilities" "format" "eio" "area:10010862"
]
homepage: "https://github.com/samoht/ocaml-console"
bug-reports: "https://github.com/samoht/ocaml-console/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.4"}
  "console"
  "eio" {>= "1.4"}
  "fmt"
  "logs"
  "cstruct"
  "optint"
  "alcotest" {with-test & >= "1.7.0"}
  "astring" {with-test}
  "mdx" {with-test}
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-console.git"
x-maintenance-intent: ["(latest)"]
