; Width is console.input's, compiled in.

(copy_files input/width.{ml,mli})

; Slot and Display_driver are not private modules, for console.tty and
; console-eio read them, but the interface of Console does not expose them, so
; odoc shows no page for them.

(library
 (name console)
 (public_name console)
 (libraries console.text fmt jsont jsont.bytesrw uucp uuseg)
 (private_modules
  border_motion
  ctx
  frames
  widget
  width
  display_core
  display_event
  display_layout
  display_region
  display_row
  display_state
  display_text
  inked
  escape
  look
  sgr
  view_core))

(mdx
 (package console)
 (files tree.mli display.mli console.mli view.mli)
 (libraries console fmt))
